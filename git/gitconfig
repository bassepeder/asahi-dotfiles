# Ported from ~/dotfiles/nixos/home/modules/git.nix (personal identity, not the ABAX one).

[user]
	name = Bastian Pedersen
	email = bastian.tangedal@gmail.com

[alias]
	l = log --pretty=format:\"%Cred%h%Creset %Cblue%ad%Creset %Cgreen%an%Creset %s\"

[core]
	editor = nvim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = false
	features = light-github
	true-color = always
	syntax-theme = none

[delta "light-github"]
	dark = false
	light = true

[merge]
	conflictStyle = zdiff3

[diff]
	tool = meld

[web]
	browser = firefox

[push]
	default = tracking
	autoSetupRemote = true

[pull]
	rebase = false

[rebase]
	autoStash = true

[branch]
	autosetupmerge = true

[init]
	defaultBranch = master

[rerere]
	enabled = true

[color]
	ui = true

[blame]
	date = relative

[paging]
	colorArg = never

[commit]
	gpgsign = false
