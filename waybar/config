{
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "spacing": 0,
    "margin-bottom": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-right": ["network#wl", "network#eth", "cpu", "disk", "battery", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "network#wl": {
        "interface": "wl*",
        "format-wifi": "W: ({signalStrength}%) {ipaddr}",
        "format-disconnected": "W: down",
        "interval": 5
    },
    "network#eth": {
        "interface": "en*",
        "format-ethernet": "| E: {ipaddr}",
        "format-disconnected": "| E: down",
        "interval": 5
    },
    "cpu": {
        "format": "| CPU: {usage}%",
        "interval": 5
    },
    "disk": {
        "path": "/",
        "format": "| Disk: {free} free",
        "interval": 30
    },
    "battery": {
        "format": "| Bat: {capacity}% {time}",
        "states": { "warning": 20, "critical": 10 }
    },
    "clock": {
        "format": "| {:%Y-%m-%d %H:%M:%S}",
        "interval": 5
    }
}
