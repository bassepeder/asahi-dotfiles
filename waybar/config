{
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "spacing": 0,
    "margin-bottom": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-right": ["clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 5
    }
}
